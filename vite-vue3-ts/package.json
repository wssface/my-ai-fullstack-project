{
  "name": "vite-vue3-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc --noEmit && vite build --config vite.config.ts",
    "build:test": "vue-tsc --noEmit && vite build --config vite.config.ts --mode test",
    "build:prod": "vue-tsc --noEmit && vite build --config vite.config.ts",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint 'src/**/*.{js,ts,vue,tsx}' --fix",
    "prettier": "prettier --write 'src/**/*.{js,ts,vue,tsx,json,css}'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/vue": "^3.0.159",
    "@eslint/js": "^10.0.1",
    "ai": "^6.0.159",
    "element-plus": "^2.13.7",
    "eslint-plugin-vue": "^10.8.0",
    "pinia": "^3.0.4",
    "typescript-eslint": "^8.58.2",
    "vue": "^3.5.32",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@minko-fe/postcss-pxtorem": "^1.5.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-component": "^1.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.2.6"
  },
  "lint-staged": {
    "src//*.{vue,js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src//*.{cjs,json,css}": [
      "prettier --write"
    ]
  }
}
